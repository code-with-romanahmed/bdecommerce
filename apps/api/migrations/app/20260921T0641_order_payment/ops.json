        "sql": "CREATE TABLE \"public\".\"order\" (\n  \"channel\" text DEFAULT 'ONLINE' NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"currency\" text DEFAULT 'BDT' NOT NULL,\n  \"customerEmail\" text,\n  \"customerId\" int4,\n  \"customerName\" text NOT NULL,\n  \"customerPhone\" text NOT NULL,\n  \"discountTotal\" numeric(12,2) NOT NULL,\n  \"grandTotal\" numeric(12,2) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"orderNumber\" text NOT NULL,\n  \"organizationId\" int4 NOT NULL,\n  \"paymentMethod\" text DEFAULT 'COD' NOT NULL,\n  \"paymentStatus\" text DEFAULT 'PENDING' NOT NULL,\n  \"shippingAddressLine1\" text NOT NULL,\n  \"shippingAddressLine2\" text,\n  \"shippingCity\" text NOT NULL,\n  \"shippingCountry\" text DEFAULT 'BD' NOT NULL,\n  \"shippingDistrict\" text NOT NULL,\n  \"shippingPhone\" text NOT NULL,\n  \"shippingPostalCode\" text,\n  \"shippingRecipientName\" text NOT NULL,\n  \"shippingTotal\" numeric(12,2) NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"subtotal\" numeric(12,2) NOT NULL,\n  \"taxTotal\" numeric(12,2) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"order_channel_check_75fb1379\" CHECK (\"channel\" IN ('ONLINE', 'POS', 'B2B')),\n  CONSTRAINT \"order_paymentMethod_check_ef242827\" CHECK (\"paymentMethod\" IN ('COD', 'BKASH', 'NAGAD', 'ROCKET', 'CARD', 'OTHER')),\n  CONSTRAINT \"order_paymentStatus_check_d0e45e8b\" CHECK (\"paymentStatus\" IN ('PENDING', 'AUTHORIZED', 'PAID', 'FAILED', 'REFUNDED', 'PARTIALLY_REFUNDED')),\n  CONSTRAINT \"order_status_check_7bbc3c00\" CHECK (\"status\" IN ('PENDING', 'CONFIRMED', 'PROCESSING', 'SHIPPED', 'DELIVERED', 'CANCELLED', 'RETURNED', 'REFUNDED'))\n)",
