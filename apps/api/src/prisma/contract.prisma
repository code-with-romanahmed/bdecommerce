// use prisma-8
enum OrganizationType {
  BUSINESS
  BRAND
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BranchType {
  STORE
  WAREHOUSE
  OFFICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Organization {
  id         Int               @id @default(autoincrement())
  name       String
  slug       String            @unique
  type       OrganizationType  @default(BUSINESS)
  status     RecordStatus      @default(ACTIVE)
  createdAt  TimestamptzString @default(now())

  branches   Branch[]
  users      User[]
  categories Category[]
  products   Product[]
  roles      Role[]
}

model Branch {
  id             Int               @id @default(autoincrement())
  organizationId Int
  name           String
  code           String
  type           BranchType        @default(STORE)
  status         RecordStatus      @default(ACTIVE)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields:[organizationId], references:[id])

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id             Int               @id @default(autoincrement())
  organizationId Int
  phone          String            @unique
  email          String?           @unique
  name           String?
  status         RecordStatus      @default(ACTIVE)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields:[organizationId], references:[id])
  userRoles      UserRole[]

  @@index([organizationId])
}

model Role {
  id             Int               @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  status         RecordStatus      @default(ACTIVE)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields:[organizationId], references:[id])
  userRoles      UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  name            String
  description     String?
  createdAt       TimestamptzString @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id        Int               @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt TimestamptzString @default(now())

  user      User              @relation(fields:[userId], references:[id])
  role      Role              @relation(fields:[roleId], references:[id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           Int               @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    TimestamptzString @default(now())

  role         Role              @relation(fields:[roleId], references:[id])
  permission   Permission        @relation(fields:[permissionId], references:[id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Category {
  id             Int               @id @default(autoincrement())
  organizationId Int
  name           String
  slug           String
  status         ProductStatus     @default(ACTIVE)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields:[organizationId], references:[id])
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Product {
  id             Int               @id @default(autoincrement())
  organizationId Int
  categoryId     Int?
  name           String
  slug           String
  description    String?
  status         ProductStatus     @default(DRAFT)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields:[organizationId], references:[id])
  category       Category?         @relation(fields:[categoryId], references:[id])
  variants       ProductVariant[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoryId])
}

model ProductVariant {
  id        Int               @id @default(autoincrement())
  productId Int
  sku       String
  name      String?
  price     Decimal
  status    ProductStatus     @default(ACTIVE)
  createdAt TimestamptzString @default(now())

  product   Product           @relation(fields:[productId], references:[id])

  @@unique([sku])
  @@index([productId])
}
