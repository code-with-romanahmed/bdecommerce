// use prisma-8

enum OrganizationType {
  BUSINESS
  BRAND
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BranchType {
  STORE
  WAREHOUSE
  OFFICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  RETURN_OUT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  CARD
  OTHER
}

enum OrderChannel {
  ONLINE
  POS
  B2B
}

model Order {
  id                    Int               @id @default(autoincrement())
  organizationId        Int
  customerId            Int?
  orderNumber           String            @unique
  status                OrderStatus       @default(PENDING)
  paymentStatus         PaymentStatus     @default(PENDING)
  paymentMethod         PaymentMethod     @default(COD)
  channel               OrderChannel      @default(ONLINE)
  currency              String            @default("BDT")

  subtotal              Numeric(12, 2)
  discountTotal         Numeric(12, 2)
  shippingTotal         Numeric(12, 2)
  taxTotal              Numeric(12, 2)
  grandTotal            Numeric(12, 2)

  customerName          String
  customerPhone         String
  customerEmail         String?

  shippingRecipientName String
  shippingPhone         String
  shippingAddressLine1  String
  shippingAddressLine2  String?
  shippingCity          String
  shippingDistrict      String
  shippingPostalCode    String?
  shippingCountry       String            @default("BD")

  createdAt             TimestamptzString @default(now())

  organization          Organization      @relation(fields: [organizationId], references: [id])
  customer              Customer?         @relation(fields: [customerId], references: [id])
  items                 OrderItem[]
  payments               Payment[]
  invoice               Invoice?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([customerId])
}

model OrderItem {
  id                Int               @id @default(autoincrement())
  orderId           Int
  productVariantId  Int

  productName       String
  sku               String

  quantity          Int
  unitPrice         Numeric(12, 2)
  lineTotal         Numeric(12, 2)

  createdAt         TimestamptzString @default(now())

  order             Order             @relation(fields: [orderId], references: [id])
  productVariant    ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
}

model Payment {
  id                Int               @id @default(autoincrement())
  orderId           Int
  amount            Numeric(12, 2)
  currency          String            @default("BDT")
  status            PaymentStatus     @default(PENDING)
  method            PaymentMethod
  transactionId     String?
  createdAt         TimestamptzString @default(now())

  order             Order             @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([transactionId])
}

model Organization {
  id                 Int                 @id @default(autoincrement())
  name               String
  slug               String              @unique
  type               OrganizationType    @default(BUSINESS)
  status             RecordStatus        @default(ACTIVE)
  createdAt          TimestamptzString   @default(now())

  branches           Branch[]
  users              User[]
  categories         Category[]
  products           Product[]
  roles              Role[]
  customers          Customer[]
  carts              Cart[]
  orders             Order[]
  cashierAssignments CashierAssignment[]
}

model Branch {
  id              Int               @id @default(autoincrement())
  organizationId  Int
  name            String
  code            String
  type            BranchType        @default(STORE)
  status          RecordStatus      @default(ACTIVE)
  createdAt       TimestamptzString @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id])
  inventoryStocks InventoryStock[]
  stockMovements  StockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  phone              String              @unique
  email              String?             @unique
  name               String?
  status             RecordStatus        @default(ACTIVE)
  createdAt          TimestamptzString   @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id])
  userRoles          UserRole[]
  customer           Customer?
  cashierAssignments CashierAssignment[] @relation("CashierAssignments")

  @@index([organizationId])
}

model Role {
  id             Int               @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  status         RecordStatus      @default(ACTIVE)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id])
  userRoles      UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  name            String
  description     String?
  createdAt       TimestamptzString @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id        Int               @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt TimestamptzString @default(now())

  user      User              @relation(fields: [userId], references: [id])
  role      Role              @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           Int               @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    TimestamptzString @default(now())

  role         Role              @relation(fields: [roleId], references: [id])
  permission   Permission        @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Category {
  id             Int               @id @default(autoincrement())
  organizationId Int
  name           String
  slug           String
  status         ProductStatus     @default(ACTIVE)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Product {
  id             Int               @id @default(autoincrement())
  organizationId Int
  categoryId     Int?
  name           String
  slug           String
  description    String?
  status         ProductStatus     @default(DRAFT)
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id])
  category       Category?         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoryId])
}

model ProductVariant {
  id              Int               @id @default(autoincrement())
  productId       Int
  sku             String
  name            String?
  price           Numeric
  status          ProductStatus     @default(ACTIVE)
  createdAt       TimestamptzString @default(now())

  product         Product           @relation(fields: [productId], references: [id])
  inventoryStocks InventoryStock[]
  stockMovements  StockMovement[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([sku])
  @@index([productId])
}

model InventoryStock {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  branchId         Int
  productVariantId Int
  quantity         Int               @default(0)
  reservedQuantity Int               @default(0)
  createdAt        TimestamptzString @default(now())

  branch           Branch            @relation(fields: [branchId], references: [id])
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])
  movements        StockMovement[]

  @@unique([branchId, productVariantId])
  @@index([organizationId])
  @@index([branchId])
  @@index([productVariantId])
}

model StockMovement {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  branchId         Int
  productVariantId Int
  inventoryStockId Int
  type             StockMovementType
  quantity         Int
  referenceType    String?
  referenceId      Int?
  note             String?
  createdAt        TimestamptzString @default(now())

  inventoryStock   InventoryStock    @relation(fields: [inventoryStockId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([productVariantId])
  @@index([inventoryStockId])
}

model Customer {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  userId             Int?                @unique
  phone              String
  email              String?
  name               String?
  status             CustomerStatus      @default(ACTIVE)
  createdAt          TimestamptzString   @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  addresses          CustomerAddress[]
  carts              Cart[]
  orders             Order[]
  cashierAssignments CashierAssignment[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([userId])
}

model CustomerAddress {
  id            Int               @id @default(autoincrement())
  customerId    Int
  label         String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  district      String
  postalCode    String?
  country       String            @default("BD")
  isDefault     Boolean           @default(false)
  createdAt     TimestamptzString @default(now())

  customer      Customer          @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([customerId, isDefault])
}

model Cart {
  id             Int               @id @default(autoincrement())
  organizationId Int
  customerId     Int?
  guestSessionId String?
  status         CartStatus        @default(ACTIVE)
  currency       String            @default("BDT")
  createdAt      TimestamptzString @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id])
  items          CartItem[]

  @@index([organizationId])
  @@index([customerId])
  @@index([guestSessionId])
  @@index([organizationId, status])
}

model CartItem {
  id               Int               @id @default(autoincrement())
  cartId           Int
  productVariantId Int
  quantity         Int
  createdAt        TimestamptzString @default(now())

  cart             Cart              @relation(fields: [cartId], references: [id])
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@index([productVariantId])
}

model Invoice {
  id              Int               @id @default(autoincrement())
  orderId         Int               @unique
  invoiceNumber   String            @unique

  currency        String            @default("BDT")

  subtotal        Numeric(12, 2)
  discountTotal   Numeric(12, 2)
  shippingTotal   Numeric(12, 2)
  taxTotal        Numeric(12, 2)
  grandTotal      Numeric(12, 2)

  customerName    String
  customerPhone   String
  customerEmail   String?

  billingAddress  String?
  shippingAddress String

  createdAt       TimestamptzString @default(now())

  order           Order             @relation(fields: [orderId], references: [id])

  @@index([invoiceNumber])
}

model CashierAssignment {
  id             Int                @id @default(autoincrement())
  organizationId Int
  cashierId      Int
  customerId     Int
  isActive       Boolean            @default(true)
  startedAt      TimestamptzString  @default(now())
  endedAt        TimestamptzString?

  organization   Organization       @relation(fields: [organizationId], references: [id])
  cashier        User               @relation("CashierAssignments", fields: [cashierId], references: [id])
  customer       Customer           @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([cashierId, isActive])
  @@index([customerId, isActive])
}
